        "jsCode": "const text = $json.message.text;\nconst parts = text.split(' ');\n\nconst name = parts[0];\nconst subname = parts[1];\nconst amount = parseFloat(parts[2]);\n\nconst interest = amount * 0.65;\nconst profit = interest / 2;\nconst total = amount + interest;\nconst pay = total / 11;\n\nreturn [{\n  json: {\n    name: name,\n    subname: subname,\n    amount: amount,\n    interest: interest,\n    profit: profit,\n    total: total,\n    weekly_payment: pay,\n    date: new Date().toLocaleDateString(\"es-MX\"),\n    hour: new Date().toLocaleTimeString(\"es-MX\")\n  }\n}];"
